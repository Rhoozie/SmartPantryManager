<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F8F3"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Pantry"
        android:textColor="#1B5E20"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvPantryCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your ingredients"
        android:textColor="#526052"
        android:textSize="15sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnAddIngredient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Add Ingredient"
        android:textAllCaps="false"
        android:backgroundTint="#2E7D32"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/tvPantryEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your pantry is empty. Add ingredients to get started."
        android:textColor="#526052"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPantryIngredients"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

    <Button
        android:id="@+id/btnPantryHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Home"
        android:textAllCaps="false" />

</LinearLayout>
